{
  "size": "100x30",
  "probe_settle": 0.4,
  "targets": {
    "input": { "query": "Input", "anchor": "topleft", "dx": 2, "dy": 1 },
    "tree_file": { "query": "DirectoryTree", "anchor": "topleft", "row": "first_file", "dx": 4 },
    "box": { "query": "VBox", "anchor": "center" }
  },
  "steps": [
    { "wait": 1.5, "marker": "启动应用" },
    { "click": "input", "marker": "@input_submitted 输入并回车" },
    { "type": "hello" },
    { "key": "enter", "delay": 0.5 },
    { "wait": 1.0 },
    { "click": "tree_file", "marker": "@directory_tree_file_selected 选择文件" },
    { "wait": 1.0 },
    { "click": "box", "marker": "@mouse_up 点击色块" },
    { "wait": 1.0 },
    { "key": "ctrl+q", "delay": 0.5, "marker": "退出" }
  ]
}
